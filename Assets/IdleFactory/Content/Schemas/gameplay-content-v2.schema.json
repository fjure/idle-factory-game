{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gameplay Content Document v2",
  "description": "Editor and documentation support only for the packaged gameplay content document version 2 (Iron factory run content) read by RunContentReader / RunContentValidator / RunCatalogBuilder. The C# reader and validator are the sole runtime enforcement authority; this schema is a precise structural reference and is checked for agreement with the reader's constants and with docs/content/json-content-pipeline.md by RunContentSchemaConsistencyTests. The timedBar-requires-durationMs rule and the locked offline policy revision 1 are expressed structurally. Cross-reference and numeric semantic rules (unknown IDs, curve.overflow, curve.stalled, speed.level.dead, batch.overflow, contract.reward.ratio, sequence, ordering and uniqueness rules, and the other codes listed in the contract) cannot be expressed in JSON Schema and are enforced only by the validator. Label and presentation-key lengths of 128 follow the v1 rules that the v2 contract carries over. Normative: specs/003-first-factory-prestige/contracts/gameplay-content-v2.md. Limits enforced by the reader and not expressible here: at most 1 MiB, JSON depth at most 16, no null, no duplicate members, integers only, IDs unchanged by trim and Unicode NFC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentSchemaVersion",
    "contentRevision",
    "runStart",
    "resources",
    "recipes",
    "machines",
    "storageLevels",
    "factoryLevels",
    "contracts",
    "items",
    "research",
    "overdrive",
    "prestige",
    "industryUpgrades",
    "offlinePolicies"
  ],
  "properties": {
    "contentSchemaVersion": {
      "description": "Content contract version, peeked first. 2 selects the v2 reader; 1 selects the unchanged Feature 002 legacy import loader (gameplay-content-v1.schema.json); any other value is rejected with content.version.unsupported.",
      "type": "integer",
      "const": 2
    },
    "contentRevision": {
      "description": "Balance revision of this document inside version 2. Retuning numbers or adding IDs increments it and stays save-compatible; every number stays a hypothesis until balance approval (R13).",
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "runStart": {
      "$ref": "#/$defs/runStart"
    },
    "resources": {
      "description": "Resource definitions, sorted by id in canonical form.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "recipes": {
      "description": "Recipe definitions. Inputs may be empty (input-free Miner); outputs may not.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/recipe"
      }
    },
    "machines": {
      "description": "Machine definitions.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/machine"
      }
    },
    "storageLevels": {
      "description": "Storage expansion table, sorted by level; starts at 1, contiguous, level 1 costs 0, capacity strictly increasing.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/storageLevel"
      }
    },
    "factoryLevels": {
      "description": "Factory expansion table, sorted by level; starts at 1, contiguous, level 1 costs 0, slots strictly increasing, at most 12.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/factoryLevel"
      }
    },
    "contracts": {
      "description": "Contract offers. Plate, Gear and timed Bar must each appear (contract.kinds.incomplete).",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "items": {
      "description": "Item definitions. Every tier 1-3 needs an Item obtainable from some contract reward (item.tiers.incomplete).",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "research": {
      "description": "Research definitions.",
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/research"
      }
    },
    "overdrive": {
      "$ref": "#/$defs/overdrive"
    },
    "prestige": {
      "$ref": "#/$defs/prestige"
    },
    "industryUpgrades": {
      "description": "Industry (Prestige) upgrade definitions.",
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/industryUpgrade"
      }
    },
    "offlinePolicies": {
      "description": "Offline policy definitions keyed by revision. The catalog accepts exactly one entry: revision 1, efficiencyNumerator 4, efficiencyDenominator 5, maxCreditedTicks 288000000000 (policy.revision-1.required otherwise).",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/offlinePolicy"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable identifier. 1-128 UTF-16 code units, unchanged by trim and Unicode NFC, compared by case-sensitive ordinal equality, unique within its family. Never derived from a label or asset path.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "label": {
      "description": "Non-blank display text, not an ID. Maximum 128 UTF-16 code units per the v1 rule carried over by the v2 contract.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "presentationKey": {
      "description": "Key into the sprite catalog, at most 128 per the v1 rule carried over. Must resolve at start-up or presentation.key.unresolved is reported.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "amount": {
      "description": "Whole units, 0 to ExactBound 10^18.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000000
    },
    "positiveAmount": {
      "description": "Whole units, 1 to ExactBound 10^18.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000000
    },
    "speedMul": {
      "description": "ppm multiplier above 10^6 (x1).",
      "type": "integer",
      "minimum": 1000001,
      "maximum": 1000000000000000000
    },
    "curve": {
      "description": "Iterative curve: v0 = base, v(n+1) = round(v(n) * growthPpm / 10^6), round being the declared rounding.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "growthPpm",
        "rounding"
      ],
      "properties": {
        "base": {
          "description": "v0, 0 to 10^18.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000000
        },
        "growthPpm": {
          "description": "Growth factor in ppm (10^6 = x1). 10^6 declares a flat curve; a larger value must strictly increase at every step (curve.stalled). Any table value above 10^18 is rejected (curve.overflow).",
          "type": "integer",
          "minimum": 1000000,
          "maximum": 1000000000000000000
        },
        "rounding": {
          "type": "string",
          "enum": [
            "ceil",
            "floor"
          ]
        }
      }
    },
    "amountEntry": {
      "description": "Resource amount. Nested lists are sorted by resourceId with no duplicate resource (recipe.resource.duplicate).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "amount"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "amount": {
          "$ref": "#/$defs/positiveAmount"
        }
      }
    },
    "unlock": {
      "description": "Closed unlock vocabulary. Evaluated at event and command timestamps; monotonic within a run.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "always"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "researchPurchased"
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "level"
          ],
          "properties": {
            "kind": {
              "const": "factoryLevelAtLeast"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "resourceProduced"
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "runStart": {
      "description": "Run start parameters and global bounds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startingCash",
        "initialUnlocks",
        "removalRefundPpm",
        "minCycleTicks",
        "maxCombinedSpeedPpm",
        "maxCombinedOutputFactor",
        "maxRewardRatioPpm"
      ],
      "properties": {
        "startingCash": {
          "$ref": "#/$defs/amount"
        },
        "initialUnlocks": {
          "description": "IDs unlocked at every run start, sorted ordinal. Unknown IDs: runstart.unlock.unknown.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "removalRefundPpm": {
          "description": "Refund share when a machine is removed, 0 to 999,999 (runstart.refund.out-of-range).",
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "minCycleTicks": {
          "description": "Minimum effective cycle in 100 ns ticks, at least the engine floor 1,000,000 = 0.1 s (runstart.min-cycle.invalid).",
          "type": "integer",
          "minimum": 1000000,
          "maximum": 1000000000000
        },
        "maxCombinedSpeedPpm": {
          "description": "Overflow bound for the composed speed, 10^6 to 10^12 (runstart.speed-bound.invalid). Valid content never reaches it (speed.level.dead).",
          "type": "integer",
          "minimum": 1000000,
          "maximum": 1000000000000
        },
        "maxCombinedOutputFactor": {
          "description": "Upper bound of the combined integer output factor, at least 2 (runstart.output-bound.invalid).",
          "type": "integer",
          "minimum": 2,
          "maximum": 1000000000000000000
        },
        "maxRewardRatioPpm": {
          "description": "Maximum contract Cash reward to market value ratio in ppm, at least 10^6 (runstart.reward-ratio.invalid).",
          "type": "integer",
          "minimum": 1000000,
          "maximum": 1000000000000000000
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "presentationKey",
        "basePrice",
        "unlock"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "presentationKey": {
          "$ref": "#/$defs/presentationKey"
        },
        "basePrice": {
          "description": "Cash per unit, whole dollars, not negative (resource.price.negative).",
          "$ref": "#/$defs/amount"
        },
        "unlock": {
          "$ref": "#/$defs/unlock"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputs",
        "outputs",
        "durationTicks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "inputs": {
          "description": "May be empty. Sorted by resourceId.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/amountEntry"
          }
        },
        "outputs": {
          "description": "At least one (recipe.outputs.empty). Sorted by resourceId.",
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/amountEntry"
          }
        },
        "durationTicks": {
          "description": "100 ns ticks, 1 to 10^12 (recipe.duration.non-positive, recipe.duration.out-of-range).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "speedPpm"
      ],
      "properties": {
        "level": {
          "description": "Machine level at which the multiplier starts, 2 to maxLevel, unique (machine.milestone.level-invalid, machine.milestone.duplicate).",
          "type": "integer",
          "minimum": 2,
          "maximum": 2147483647
        },
        "speedPpm": {
          "$ref": "#/$defs/speedMul"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "presentationKey",
        "recipeId",
        "maxLevel",
        "cost",
        "speedGrowthPpm",
        "milestones",
        "unlock"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "presentationKey": {
          "$ref": "#/$defs/presentationKey"
        },
        "recipeId": {
          "$ref": "#/$defs/id"
        },
        "maxLevel": {
          "description": "1 or more (machine.max-level.invalid).",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "cost": {
          "description": "Cost per level.",
          "$ref": "#/$defs/curve"
        },
        "speedGrowthPpm": {
          "description": "Per-level speed growth in ppm, above 10^6 so that SpeedTable strictly increases (speed.level.dead).",
          "$ref": "#/$defs/speedMul"
        },
        "milestones": {
          "description": "Sorted by level.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "unlock": {
          "$ref": "#/$defs/unlock"
        }
      }
    },
    "storageLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "capacity",
        "cost"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "capacity": {
          "$ref": "#/$defs/positiveAmount"
        },
        "cost": {
          "$ref": "#/$defs/amount"
        }
      }
    },
    "factoryLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "slots",
        "cost"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "slots": {
          "description": "1 to 12 (factory.slots.too-many).",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "cost": {
          "$ref": "#/$defs/amount"
        }
      }
    },
    "contractReward": {
      "description": "Closed reward vocabulary: cash curve, rp curve, item grant.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "curve"
          ],
          "properties": {
            "kind": {
              "const": "cash"
            },
            "curve": {
              "$ref": "#/$defs/curve"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "curve"
          ],
          "properties": {
            "kind": {
              "const": "rp"
            },
            "curve": {
              "$ref": "#/$defs/curve"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "itemId",
            "onCompletionIndices"
          ],
          "properties": {
            "kind": {
              "const": "item"
            },
            "itemId": {
              "$ref": "#/$defs/id"
            },
            "onCompletionIndices": {
              "description": "Completion indices (0-based) at which the Item is granted. 0 to 1023 because a contract table has 1,024 entries; at most 256 entries (nested list limit); written ascending in canonical form. The contract states no minimum count or uniqueness rule.",
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              }
            }
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "resourceId",
        "quantity",
        "rewards",
        "unlock"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "description": "Closed vocabulary (contract.kind.unknown). Each kind requires its own resource (contract.kind.resource-mismatch).",
          "type": "string",
          "enum": [
            "plate",
            "gear",
            "timedBar"
          ]
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "quantity": {
          "description": "Required units by completion index.",
          "$ref": "#/$defs/curve"
        },
        "durationMs": {
          "description": "Required exactly for timedBar, forbidden otherwise (contract.duration.required, contract.duration.forbidden). Milliseconds, 1 to 604800000 (contract.duration.out-of-range).",
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "rewards": {
          "description": "At least one (contract.reward.empty).",
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/contractReward"
          }
        },
        "unlock": {
          "$ref": "#/$defs/unlock"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timedBar"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "durationMs"
            ]
          },
          "else": {
            "not": {
              "required": [
                "durationMs"
              ]
            }
          }
        }
      ]
    },
    "itemTarget": {
      "description": "Item target: the whole factory, or a machine type with a non-empty allowedMachineIds (item.target.invalid). machineSpeed and machineOutput Items apply to every machine of the chosen type.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "factory"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "allowedMachineIds"
          ],
          "properties": {
            "kind": {
              "const": "machineType"
            },
            "allowedMachineIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "itemEffect": {
      "description": "Effects an Item may carry.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "speedPpm"
          ],
          "properties": {
            "kind": {
              "const": "machineSpeed"
            },
            "speedPpm": {
              "$ref": "#/$defs/speedMul"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "factor"
          ],
          "properties": {
            "kind": {
              "const": "machineOutput"
            },
            "factor": {
              "description": "Integer 2 to maxCombinedOutputFactor.",
              "type": "integer",
              "minimum": 2,
              "maximum": 1000000000000000000
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "label",
        "presentationKey",
        "durationMs",
        "target",
        "effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tier": {
          "description": "1 to 3 (item.tier.invalid).",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "presentationKey": {
          "$ref": "#/$defs/presentationKey"
        },
        "durationMs": {
          "description": "Effect duration in milliseconds, 1 to 604800000 (item.duration.non-positive, item.duration.out-of-range).",
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "target": {
          "$ref": "#/$defs/itemTarget"
        },
        "effect": {
          "$ref": "#/$defs/itemEffect"
        }
      }
    },
    "effectTarget": {
      "description": "Effect target vocabulary. allMachines/machine for machineSpeed, machineOutput (machine only) and upgradeCost; allResources/resource for salePrice; expansion (no id) for upgradeCost, which lowers the upgrade cost of both expansion tracks, storage and factory, because the domain EffectDef has no track discriminator.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "allMachines"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "allResources"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "machine"
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "resource"
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "expansion"
            }
          }
        }
      ]
    },
    "researchEffect": {
      "description": "Effects Research may carry (contract sources table).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "valuePerLevelPpm"
          ],
          "properties": {
            "kind": {
              "const": "machineSpeed"
            },
            "target": {
              "$ref": "#/$defs/effectTarget"
            },
            "valuePerLevelPpm": {
              "$ref": "#/$defs/speedMul"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "factor"
          ],
          "properties": {
            "kind": {
              "const": "machineOutput"
            },
            "target": {
              "$ref": "#/$defs/effectTarget"
            },
            "factor": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1000000000000000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "valuePerLevelPpm"
          ],
          "properties": {
            "kind": {
              "const": "salePrice"
            },
