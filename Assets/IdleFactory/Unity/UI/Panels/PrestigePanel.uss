/* Prestige panel (T117, FR-020 to FR-022, FR-024, FR-032, FR-033). Font sizes come only from the shell's --run-fs-* variables so the
   panel follows the text scale (contracts/ui-surfaces.md, panel rule). Colours are Art Bible UI tokens defined on .run-shell. Nothing
   here sets a fixed height on a control and nothing uses white-space: nowrap, so text wraps at 200 percent and the sheet scrolls. */

.prestige-panel {
    flex-direction: column;
    flex-shrink: 0;
}

.prestige-panel Label {
    white-space: normal;
    flex-shrink: 0;
    margin: 0;
}

.prestige-title {
    font-size: var(--run-fs-value);
    color: var(--text-strong);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.prestige-title--warning {
    color: var(--warning);
}

.prestige-section-title {
    font-size: var(--run-fs-body);
    color: var(--text-secondary);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.prestige-card {
    flex-direction: column;
    flex-shrink: 0;
    background-color: var(--surface);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 8px;
    margin-bottom: 8px;
}

.prestige-card--saving {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}

.prestige-card--failure {
    border-left-color: var(--warning);
    border-right-color: var(--warning);
    border-top-color: var(--warning);
    border-bottom-color: var(--warning);
}

.prestige-line {
    font-size: var(--run-fs-body);
    color: var(--text-primary);
    margin-top: 2px;
}

.prestige-line--strong {
    font-size: var(--run-fs-value);
    color: var(--text-strong);
    -unity-font-style: bold;
}

.prestige-line--warning {
    color: var(--warning);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.prestige-hint {
    font-size: var(--run-fs-caption);
    color: var(--text-secondary);
    margin-top: 4px;
}

.prestige-feedback {
    font-size: var(--run-fs-caption);
    color: var(--warning);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.prestige-list {
    flex-direction: column;
    flex-shrink: 0;
}

.prestige-list Label {
    font-size: var(--run-fs-body);
    color: var(--text-primary);
    margin-top: 2px;
}

.prestige-actions {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 4px;
}

.prestige-actions .run-button {
    margin-right: 8px;
    margin-bottom: 4px;
}
