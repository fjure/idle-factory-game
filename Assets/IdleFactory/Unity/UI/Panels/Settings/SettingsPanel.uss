/* Settings sheet (T433, OD-8). Text sizes only through the shell --run-fs-* variables (200 percent text scale); controls keep
   min-height 44px and no fixed height; nothing is nowrap. */

.set-panel {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.set-card {
    flex-direction: column;
    flex-shrink: 0;
    padding: 8px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
}

.set-group-label {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--run-fs-body);
    -unity-font-style: bold;
    color: var(--text-strong);
}

.set-hint {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--run-fs-caption);
    color: var(--text-secondary);
    margin-top: 2px;
}

.set-radios {
    flex-direction: column;
    flex-shrink: 0;
}

.set-radio {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 44px;
    margin-bottom: 4px;
    padding: 4px 8px;
    background-color: var(--surface);
    border-width: 1.5px;
    border-color: var(--text-muted);
}

.set-radio--selected {
    border-color: var(--accent);
    background-color: var(--bg);
}

/* The selected state is a filled mark and a "selected" word in the label, never colour alone. */
.set-radio__mark {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--text-primary);
    background-color: rgba(0, 0, 0, 0);
}

.set-radio--selected .set-radio__mark {
    background-color: var(--accent);
}

.set-radio__label {
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    font-size: var(--run-fs-body);
    color: var(--text-primary);
    -unity-text-align: middle-left;
}

.set-radio__suffix {
    display: none;
    flex-shrink: 0;
    margin-left: 6px;
    white-space: normal;
    font-size: var(--run-fs-caption);
    color: var(--text-secondary);
    -unity-text-align: middle-left;
}

.set-radio--selected .set-radio__suffix {
    display: flex;
}

/* A narrow landscape column at large text keeps each label to two lines: the word drops out, the filled mark and the border stay (T455 F3). */
.run-text-scale--150.factory-hud--compact-landscape .set-radio__suffix,
.run-text-scale--160.factory-hud--compact-landscape .set-radio__suffix,
.run-text-scale--170.factory-hud--compact-landscape .set-radio__suffix,
.run-text-scale--180.factory-hud--compact-landscape .set-radio__suffix,
.run-text-scale--190.factory-hud--compact-landscape .set-radio__suffix,
.run-text-scale--200.factory-hud--compact-landscape .set-radio__suffix {
    display: none;
}

/* The live state sits above the radios (T475, T455 F1). */
.set-effective {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--run-fs-body);
    color: var(--text-primary);
    margin-top: 2px;
    margin-bottom: 4px;
}

.set-not-saved {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--run-fs-body);
    color: var(--warning);
    margin-bottom: 6px;
}
