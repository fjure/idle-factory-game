/* PanelScaffold (F006 T533; FR-005, FR-023; research R11; Art Bible section 11). Colours only through the F003 chrome tokens
   and text sizes only through the shell --run-fs-* variables, so the 100 to 200 percent text scale applies. Touch targets are
   48 pt (UI/UX C4), nothing is nowrap, and nothing animates (UI/UX C5: the loading state is static). */

.scaffold {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    background-color: var(--bg);
}

/* Header: back first, then the title. At most 15 percent of the screen at 100 % text and 20 % at 200 % (UI/UX C6). */
.scaffold__header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 48px;
    padding: 0 8px;
    background-color: var(--surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.scaffold .scaffold__back {
    flex-shrink: 0;
    margin: 0 8px 0 0;
}

.scaffold__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--run-fs-value);
    -unity-font-style: bold;
    color: var(--text-strong);
    -unity-text-align: middle-left;
}

.scaffold__stage {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.scaffold__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 8px;
}

/* Buttons: primary is the filled accent, secondary the raised outline. Both are at least 48 x 48 pt. */
.scaffold .scaffold-button {
    min-width: 48px;
    min-height: 48px;
    flex-shrink: 0;
    max-width: 100%;
    padding: 8px 12px;
    margin: 0;
    font-size: var(--run-fs-body);
    -unity-font-style: bold;
}

.scaffold .scaffold-button--primary {
    background-color: var(--accent);
    color: var(--on-accent);
    border-left-color: var(--text-strong);
    border-right-color: var(--text-strong);
    border-top-color: var(--text-strong);
    border-bottom-color: var(--text-strong);
}

.scaffold .scaffold-button--secondary {
    background-color: var(--surface-raised);
    color: var(--text-primary);
}

/* The one disabled state (shape, text and contrast, never dimming alone): square corners and a thick left bar instead of the
   rounded outline, the plain surface instead of a fill, muted text that still reads at 4.5:1 or better, and a reason line the
   caller shows beside it. The control stays focusable (soft-disabled) and the opacity stays 1. */
.scaffold .scaffold-button.scaffold-button--disabled {
    background-color: var(--surface);
    color: var(--text-muted);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-left-width: 6px;
    border-left-color: var(--border);
    border-right-width: 1px;
    border-right-color: var(--border);
    border-top-width: 1px;
    border-top-color: var(--border);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.scaffold__reason {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--run-fs-caption);
    color: var(--warning);
    margin-top: 2px;
}

.scaffold__state-scroll {
    display: none;
}

/* State template: empty, loading and error share one card; a marker box (shape), a title, a message and recovery actions. */
.scaffold__state {
    display: none;
    flex-direction: column;
    flex-shrink: 0;
    margin: 8px;
    padding: 12px;
    background-color: var(--surface-raised);
    border-left-width: 6px;
    border-left-color: var(--accent);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--border);
    border-right-color: var(--border);
    border-bottom-color: var(--border);
}

.scaffold__state--shown {
    display: flex;
}

.scaffold__state--error {
    border-left-color: var(--danger);
}

.scaffold__state--empty {
    border-left-color: var(--text-muted);
}

.scaffold__mark {
    align-self: flex-start;
    min-width: 28px;
    min-height: 28px;
    margin-bottom: 6px;
    padding: 0 6px;
    font-size: var(--run-fs-value);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--on-accent);
    background-color: var(--accent);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.scaffold__state--error .scaffold__mark {
    background-color: var(--danger);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.scaffold__state--empty .scaffold__mark {
    background-color: var(--text-muted);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.scaffold__state-title {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--run-fs-value);
    -unity-font-style: bold;
    color: var(--text-strong);
}

.scaffold__state-message {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--run-fs-body);
    color: var(--text-primary);
    margin-top: 4px;
}

/* A static bar for the loading state: no animation, so reduced motion needs no other form. */
.scaffold__bar {
    display: none;
    flex-shrink: 0;
    height: 8px;
    margin-top: 8px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
}

.scaffold__bar-fill {
    width: 33%;
    background-color: var(--accent);
}

.scaffold__state--loading .scaffold__bar {
    display: flex;
}

.scaffold__actions {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 8px;
}

.scaffold__actions .scaffold-button {
    margin: 0 8px 8px 0;
}

/* Notices sit last in the stage, so they layer above the body and above any sheet mounted in it. The layer takes no pointer;
   its rows do. */
.scaffold__notices {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    flex-direction: column;
}

.scaffold__notice {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 4px 8px 0 8px;
    padding: 0 0 0 8px;
    background-color: var(--surface-raised);
    border-left-width: 6px;
    border-left-color: var(--accent);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--border);
    border-right-color: var(--border);
    border-bottom-color: var(--border);
}

.scaffold__notice--warning {
    border-left-color: var(--warning);
}

.scaffold__notice--error {
    border-left-color: var(--danger);
}

.scaffold__notice-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--run-fs-body);
    color: var(--text-primary);
    margin: 0 8px 0 0;
    -unity-text-align: middle-left;
}

.scaffold .scaffold__notice .scaffold-button {
    margin: 0;
}

/* T535 (P2-F17): the sheet mount point. An overlay over the body (transparent, no pointer) for a docked sheet; it takes no space until used. */
.scaffold__sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
}

/* T535 (P2-F17): the shared row. A run control (shell focus ring, 44 pt floor) raised to 48 dp, full width, icon then text, text wraps. */
.scaffold .scaffold-row,
.scaffold-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 48px;
    min-height: 48px;
    margin: 0 0 4px 0;
    padding: 4px 8px;
    background-color: var(--surface-raised);
    -unity-text-align: middle-left;
}

.scaffold-row .run-icon {
    margin-right: 8px;
}
