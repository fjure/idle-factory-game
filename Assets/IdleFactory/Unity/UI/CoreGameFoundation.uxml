<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="factory-hud" class="factory-hud factory-hud--compact-portrait">
        <ui:VisualElement name="side-panels" class="factory-hud__side-panels">
            <ui:VisualElement name="information-panel" class="factory-hud__information">
                <ui:Label name="feedback" text="" class="factory-hud__feedback" />
                <ui:Label name="status" text="The factory is starting." class="factory-hud__status" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
