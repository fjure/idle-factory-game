/* The start-up status HUD. T119 retired the Feature 001 placement actions, machine inspector and Save and return panels;
   only the status panel that reports a start-up failure remains. */
.factory-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 8px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    color: rgb(243, 244, 246);
}

.factory-hud__side-panels {
    width: 100%;
    max-width: 460px;
    max-height: 58%;
    min-height: 0;
    flex-shrink: 1;
    align-self: flex-start;
}

.factory-hud__information {
    width: 100%;
    padding: 8px;
    background-color: rgba(17, 24, 39, 0.94);
    border-radius: 4px;
}

/* The information panel keeps its full wrapped text height (T053: a squeezed panel drew its text over the next panel). */
.factory-hud__information,
.factory-hud__information > * {
    flex-shrink: 0;
}

.factory-hud__feedback,
.factory-hud__status {
    white-space: normal;
    margin-top: 3px;
}

.factory-hud--compact-portrait,
.factory-hud--tablet-portrait,
.factory-hud--compact-landscape {
    flex-direction: column;
}

.factory-hud--compact-landscape .factory-hud__side-panels {
    max-height: 72%;
}

.factory-hud--tablet-landscape,
.factory-hud--desktop {
    flex-direction: row;
    align-items: flex-end;
}

.factory-hud--tablet-landscape .factory-hud__side-panels,
.factory-hud--desktop .factory-hud__side-panels {
    width: 400px;
    max-height: 82%;
    flex-shrink: 1;
}

.factory-hud--error .factory-hud__feedback,
.factory-hud--error .factory-hud__status {
    color: rgb(255, 178, 178);
}

.factory-hud--disabled .factory-hud__feedback {
    color: rgb(255, 224, 138);
}
