.factory-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 8px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    color: rgb(243, 244, 246);
}

.factory-hud__side-panels {
    width: 100%;
    max-width: 460px;
    max-height: 58%;
    min-height: 0;
    flex-shrink: 1;
    align-self: flex-start;
}

.factory-hud__information,
.machine-inspector {
    width: 100%;
    padding: 8px;
    background-color: rgba(17, 24, 39, 0.94);
    border-radius: 4px;
}

/* The information panel keeps its full wrapped text height; the inspector scroll view absorbs any
   shortage of vertical space instead (T053: a squeezed panel drew its text over the next panel). */
.factory-hud__information,
.factory-hud__information > * {
    flex-shrink: 0;
}

.factory-hud__label,
.factory-hud__feedback,
.factory-hud__status,
.machine-inspector__label,
.machine-inspector__state,
.machine-inspector__blockers,
.machine-inspector__feedback,
.machine-inspector__empty {
    white-space: normal;
    margin-top: 3px;
}

.factory-hud__mode,
.machine-inspector__title,
.machine-inspector__state {
    -unity-font-style: bold;
    font-size: 16px;
}

.factory-hud__inspector-scroll > .unity-scroll-view__content-viewport {
    min-height: 0;
}

.factory-hud__inspector-scroll .unity-scroll-view__content-container,
.machine-inspector,
.factory-persistence {
    flex-shrink: 0;
}

.factory-hud__inspector-scroll {
    width: 100%;
    max-height: 50%;
    min-height: 44px;
    margin-top: 4px;
    flex-shrink: 1;
    background-color: rgba(17, 24, 39, 0.94);
    border-radius: 4px;
}

.machine-inspector {
    min-width: 0;
}

.machine-inspector__selected {
    min-width: 0;
}

.machine-inspector__actions,
.factory-hud__actions,
.factory-persistence__actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.machine-inspector__actions {
    margin-top: 4px;
}

.factory-hud__actions {
    max-width: 100%;
    max-height: 37%;
    align-content: flex-start;
    overflow: hidden;
}

.factory-hud__control {
    min-width: 44px;
    min-height: 44px;
    margin-top: 4px;
    margin-right: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    white-space: normal;
}

.factory-hud__control:focus {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(55, 65, 81);
}

.factory-hud__control.machine-inspector__control--focused {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(55, 65, 81);
}

.factory-hud__control.factory-persistence__control--focused {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(55, 65, 81);
}

.factory-hud__control:disabled {
    opacity: 0.7;
}

.factory-hud--compact-portrait,
.factory-hud--tablet-portrait,
.factory-hud--compact-landscape {
    flex-direction: column;
}

.factory-hud--compact-landscape .factory-hud__side-panels {
    max-height: 72%;
}

.factory-hud--compact-landscape .factory-hud__actions {
    max-height: 36%;
}

.factory-hud--tablet-landscape,
.factory-hud--desktop {
    flex-direction: row;
    align-items: flex-end;
}

.factory-hud--tablet-landscape .factory-hud__side-panels,
.factory-hud--desktop .factory-hud__side-panels {
    width: 400px;
    max-height: 82%;
    flex-shrink: 1;
}

.factory-hud--tablet-landscape .factory-hud__inspector-scroll,
.factory-hud--desktop .factory-hud__inspector-scroll {
    max-height: 61%;
}

.factory-hud--tablet-landscape .factory-hud__actions,
.factory-hud--desktop .factory-hud__actions {
    max-width: 55%;
    max-height: 42%;
    justify-content: flex-end;
    align-self: flex-end;
}

.machine-inspector--producing .machine-inspector__state {
    color: rgb(164, 245, 181);
}

.machine-inspector--inactive .machine-inspector__state {
    color: rgb(255, 224, 138);
}

.machine-inspector--blocked .machine-inspector__state,
.machine-inspector__feedback--error,
.factory-hud--error .factory-hud__feedback,
.factory-hud--error .factory-hud__status {
    color: rgb(255, 178, 178);
}

.factory-hud--disabled .factory-hud__feedback {
    color: rgb(255, 224, 138);
}

.factory-persistence {
    width: 100%;
    min-width: 0;
    margin-top: 4px;
    padding: 8px;
    background-color: rgba(17, 24, 39, 0.94);
    border-radius: 4px;
}

.factory-persistence__title {
    -unity-font-style: bold;
    font-size: 16px;
}

.factory-persistence__description,
.factory-persistence__status,
.factory-persistence__feedback,
.factory-persistence__summary {
    white-space: normal;
    margin-top: 3px;
}

.factory-persistence__actions {
    margin-top: 4px;
}

.factory-persistence__summary {
    display: none;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(243, 244, 246, 0.35);
}

.factory-persistence--error .factory-persistence__feedback,
.factory-persistence--error .factory-persistence__status {
    color: rgb(255, 178, 178);
}

.factory-persistence--warning .factory-persistence__feedback,
.factory-persistence--warning .factory-persistence__status {
    color: rgb(255, 224, 138);
}
